{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "euchre",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "src/worker.ts",
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "29d914fb9e6f4cd0acd5a2239dd9d247",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STREAM_ADMISSION",
        "class_name": "LiveStreamAdmissionGate",
      },
      {
        "name": "ROOM_COORDINATOR",
        "class_name": "RoomCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveStreamAdmissionGate"],
    },
    {
      "tag": "v2-room-coordinator",
      "new_sqlite_classes": ["RoomCoordinator"],
    },
  ],
  "vars": {
    "ROOM_COORDINATOR_MODE": "off",
    "ROOM_COORDINATOR_PERCENTAGE": "0",
  },
  "queues": {
    "producers": [
      {
        "binding": "RATING_QUEUE",
        "queue": "rating-reconciliation",
      },
      {
        "binding": "ROOM_WAKEUP_QUEUE",
        "queue": "room-coordinator-wakeups",
      },
    ],
    "consumers": [
      {
        "queue": "rating-reconciliation",
        "dead_letter_queue": "rating-reconciliation-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
      },
      {
        "queue": "room-coordinator-wakeups",
        "dead_letter_queue": "room-coordinator-wakeups-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 4,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "placement": {
    "region": "aws:us-east-1",
  },
}
